# Base de Datos (Supabase)
DATABASE_URL=             # Transaction pooler (puerto 6543)
DIRECT_URL=               # Session pooler (puerto 5432) - migraciones
SUPABASE_PASSWORD=

# App
NEXT_PUBLIC_APP_NAME=MundoBL

# Auth (NextAuth + Google OAuth)
# - En produccion: https://mundobl.com.ar
# - En dev: http://localhost:3000
# Recordá agregar AMBAS URLs (mas https://mundobl.win/api/auth/callback/google
# como backup) a "Authorized redirect URIs" del cliente OAuth en Google Cloud Console:
#   https://mundobl.com.ar/api/auth/callback/google
#   https://mundobl.win/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
NEXTAUTH_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=             # CSV de emails admin

# Supabase Storage (subida de imagenes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Integraciones externas
YOUTUBE_API_KEY=          # YouTube Data API v3
VIMEO_CLIENT_ID=
VIMEO_ACCESS_TOKEN=
GEMINI_API_KEY=           # Google Gemini (asistente IA)

# Cloudflare R2 (almacenamiento de imagenes)
# Sin estas 5, las subidas caen a Supabase Storage — que cobra egress.
# Las credenciales salen de: Cloudflare > R2 > API > Manage API tokens
# (permiso "Object Read & Write" sobre el bucket).
R2_ACCOUNT_ID=            # 5f41ffae9202926d95a48448ea3965bd
R2_ACCESS_KEY_ID=         # Access Key ID del token de R2
R2_SECRET_ACCESS_KEY=     # Secret Access Key del token de R2
R2_BUCKET=                # mundobl-images
R2_PUBLIC_HOST=           # img.mundobl.com.ar

# Email (Resend)
RESEND_API_KEY=           # Clave API de Resend (https://resend.com)
EMAIL_FROM=               # Remitente verificado (ej: MundoBL <notificaciones@send.mundobl.com.ar>)
EMAIL_REPLY_TO=           # A donde responden (ej: hola@mundobl.com.ar). El subdominio
                          # de envio no tiene buzon: sin esto las respuestas se pierden.

# Crons (Vercel)
# Vercel manda el header Authorization: Bearer <CRON_SECRET> en cada
# invocacion programada de vercel.json. Sin esta var el endpoint responde
# 503 y el cron corre todos los dias sin hacer nada: cargala en Vercel
# (Settings > Environment Variables) ademas de aca.
CRON_SECRET=              # String random largo (ej: openssl rand -hex 32)

# Web Push (notificaciones del navegador)
# El par de claves VAPID firma cada push. Generarlas una sola vez con
# `npx web-push generate-vapid-keys`. OJO: si se pierde la privada hay que
# generar un par nuevo y TODAS las suscripciones existentes quedan invalidas
# (los navegadores las rechazan). Es un secreto a respaldar, no regenerable.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # Clave publica (viaja al browser)
VAPID_PRIVATE_KEY=              # Clave privada (server-only)
VAPID_SUBJECT=                  # mailto: de contacto. Default: mailto:admin@mundobl.com.ar

# Feature flags
NEXT_PUBLIC_ENABLE_COMMUNITY_DONATIONS=   # 'true' para mostrar la seccion de donaciones

# Gemini: override de la cadena de modelos (csv). Sin esto usa el default de
# src/lib/gemini.ts (gemini-2.5-flash -> gemini-flash-latest -> 2.5-flash-lite).
GEMINI_MODELS=

# ---------------------------------------------------------------------------
# Perillas opcionales de costo y proteccion. TODAS tienen default en codigo:
# solo definirlas para cambiar el comportamiento, no hacen falta para levantar
# el proyecto. Los defaults estan elegidos para gastar poco.
# ---------------------------------------------------------------------------

# Logging anonimo en src/proxy.ts. Esta DESHABILITADO a proposito por costo de
# egress: AccessLog ya no refleja el trafico real (la fuente de verdad es
# Vercel Analytics). Prender esto vuelve a gastar.
PUBLIC_ANON_LOG_DISABLED=              # default: true (deshabilitado)
PUBLIC_PAGE_LOG_SAMPLE_HIGH=           # default: 0.1
PUBLIC_PAGE_LOG_SAMPLE_LOW=            # default: 0.01
PUBLIC_ANON_LOG_GUARD_ENABLED=         # default: true
PUBLIC_ANON_LOG_GUARD_WINDOW_MS=
PUBLIC_ANON_LOG_GUARD_HIT_THRESHOLD=
PUBLIC_ANON_LOG_GUARD_COOLDOWN_MS=

# Freno de emergencia de runtime (src/lib/runtime-freeze.ts).
RUNTIME_FREEZE_AUTO_ENABLED=
RUNTIME_FREEZE_WINDOW_MS=
RUNTIME_FREEZE_HIT_THRESHOLD=
RUNTIME_FREEZE_COOLDOWN_MS=
RUNTIME_FREEZE_FORCE=

# Links del proyecto (admin/info)
PROJECT_GITHUB_URL=
PROJECT_VERCEL_URL=
PROJECT_SUPABASE_URL=

