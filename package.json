{
  "name": "mundobl-catalogo",
  "version": "0.1.0",
  "private": true,
  "author": "famantini@live.com.ar",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --hostname 0.0.0.0",
    "build": "prisma generate && cross-env NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "node scripts/test-all.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "test:fast": "node scripts/test-all.mjs --fast",
    "local:db": "bash scripts/local-db.sh",
    "local:dev": "bash scripts/local-db.sh && npm run dev",
    "migrate:supabase": "node scripts/migrate-supabase.mjs",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "prepare": "node scripts/install-git-hooks.mjs",
    "audit:prod": "npm audit --omit=dev",
    "audit:dependencies": "npm audit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/d3-geo": "^3.1.1",
    "@types/react-simple-maps": "^3.0.6",
    "@uiw/react-md-editor": "^4.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "antd": "^6.6.8",
    "aws4fetch": "^1.0.20",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "fast-xml-parser": "^5.11.2",
    "flag-icons": "^7.6.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "schema-dts": "^1.1.5",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "npm-check-updates": "^19.6.6",
    "playwright": "^1.64.1",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "d3-color": "^3.1.0",
    "sharp": "^0.35.5",
    "eslint-config-next": {
      "eslint-plugin-react-hooks": "7.0.1"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.11.1": true
  }
}
